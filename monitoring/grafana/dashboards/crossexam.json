{
  "title": "CrossExam",
  "uid": "crossexam",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "15s",
  "panels": [
    {
      "type": "stat",
      "title": "Documents extracted",
      "description": "All time, read from the database by the API, so it matches the web screen.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max(crossexam_documents{status=\"extracted\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Documents failed",
      "description": "All time, read from the database by the API.",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max(crossexam_documents{status=\"failed\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Waiting for a person",
      "description": "Packs awaiting approval or needing review, as in the review queue.",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(max by (status) (crossexam_packs{status=~\"awaiting_approval|needs_review\"}))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "AI spend (all time)",
      "description": "Sum of the cost ledger, read from the database by the API.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max(crossexam_ai_spend_usd)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Task failures (1h)",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(crossexam_task_failures_total[1h])) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Injection attempts blocked",
      "description": "Documents the injection guard cleaned, all time. Read from the database by the API, so it matches the Suspicious content issue in the review queue.",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max(crossexam_injection_documents)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Documents by status",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max by (status) (crossexam_documents) > 0",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Packs by status",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max by (status) (crossexam_packs) > 0",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Queue length by priority",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "crossexam_queue_length",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Documents processed per minute",
      "description": "Average over the last 5 minutes, read from the database by the API.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max by (outcome) (crossexam_documents_per_minute)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Task duration p95",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, task) (rate(crossexam_task_duration_seconds_bucket[5m])))",
          "legendFormat": "{{task}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Task failures",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (task) (rate(crossexam_task_failures_total[5m]))",
          "legendFormat": "{{task}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "AI spend by agent",
      "description": "Spend in the hour before each point, from the cost ledger in the database, so it matches the Monitoring page.",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max by (agent) (crossexam_ai_spend_last_hour_usd)",
          "legendFormat": "{{agent}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "AI latency p95 by model",
      "description": "Over the last 5 minutes, from the cost ledger in the database.",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max by (model) (crossexam_llm_latency_p95_seconds)",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Packs routed",
      "description": "Packs created in the hour before each point, by route. Read from the database by the API, the same way as the routes on the Monitoring page.",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max by (route) (crossexam_packs_routed_last_hour)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tokens per minute",
      "description": "Average over the last 5 minutes, from the cost ledger in the database.",
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max by (direction) (crossexam_llm_tokens_per_minute)",
          "legendFormat": "{{direction}}",
          "refId": "A"
        }
      ]
    }
  ]
}