# Copy to .env and fill in. Never commit .env.

# --- LLM ------------------------------------------------------------------
# gemini (API key) | vertex (GCP project auth) | openai
LLM_PROVIDER=gemini
GOOGLE_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=

# Model tiers - check https://ai.google.dev/models for current IDs
MODEL_SMALL=gemini-3.5-flash-lite
MODEL_MID=gemini-3.8-flash
MODEL_STRONG=gemini-3.8-flash
MODEL_FALLBACK=gemini-3.1-flash-lite
MODEL_VISION=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001

# USD per 1M tokens, [input, output]. PLACEHOLDERS - set from the current price list.
MODEL_PRICES_JSON={"default": [0.10, 0.40]}

# Shared across ALL workers. Set below your provider's requests-per-minute limit.
LLM_REQUESTS_PER_MINUTE=60

# --- LangSmith (optional, recommended) -------------------------------------
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT=crossexam

# --- Business rules --------------------------------------------------------
CONFIDENCE_THRESHOLD=0.80
DEFAULT_PRICE_TOLERANCE_PCT=2.0
MIN_SHELF_LIFE_DAYS=180
MANAGER_APPROVAL_THRESHOLD_INR=500000

# --- Observability ---------------------------------------------------------
LOG_LEVEL=INFO
METRICS_EXPORTER=prometheus
OTEL_EXPORTER=none

# --- Local infrastructure (docker compose overrides these) -----------------
DATABASE_URL=postgresql+psycopg://crossexam:crossexam@localhost:5432/crossexam
REDIS_URL=redis://localhost:6379/0
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage
